CREATE TABLE QEntity (
    id TEXT NOT NULL PRIMARY KEY,
    text TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

selectAll:
SELECT * FROM QEntity ORDER BY updatedAt DESC;

selectById:
SELECT * FROM QEntity WHERE id = ?;

insert:
INSERT INTO QEntity(id, text, createdAt, updatedAt) VALUES (?, ?, ?, ?);

updateText:
UPDATE QEntity SET text = ?, updatedAt = ? WHERE id = ?;

deleteById:
DELETE FROM QEntity WHERE id = ?;
