CREATE TABLE QEntity (
    id TEXT NOT NULL PRIMARY KEY,
    text TEXT NOT NULL,
    tagsJson TEXT NOT NULL DEFAULT '[]',
    alarmsJson TEXT NOT NULL DEFAULT '[]',
    priority TEXT NOT NULL DEFAULT 'medium',
    completed INTEGER NOT NULL DEFAULT 0,
    voiceNotePath TEXT,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

selectAll:
SELECT * FROM QEntity ORDER BY updatedAt DESC;

selectById:
SELECT * FROM QEntity WHERE id = ?;

insert:
INSERT INTO QEntity(id, text, tagsJson, alarmsJson, priority, completed, voiceNotePath, createdAt, updatedAt) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateFields:
UPDATE QEntity SET text = ?, tagsJson = ?, alarmsJson = ?, priority = ?, completed = ?, voiceNotePath = ?, updatedAt = ? WHERE id = ?;

deleteById:
DELETE FROM QEntity WHERE id = ?;
