<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Voice-note playback: dim screen with the proximity wake-lock when held to ear,
         and toggle speaker/earpiece routing via AudioManager. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Alarms: USE_EXACT_ALARM is auto-granted for apps Play Store classifies as
         alarm/calendar (33+). On 31-32 we fall back to SCHEDULE_EXACT_ALARM (user-
         revocable; AndroidAlarmScheduler degrades to inexact if denied). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Required on Android 13+ to post the alarm notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-schedule pending alarms after a reboot (AlarmManager doesn't persist). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="quiQs"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <uses-native-library android:name="libvndksupport.so" android:required="false"/>
        <uses-native-library android:name="libOpenCL.so" android:required="false"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".alarms.AlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
